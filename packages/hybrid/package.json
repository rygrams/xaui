{
  "name": "@xaui/hybrid",
  "version": "0.9.0-beta.0",
  "private": true,
  "description": "The @xaui/native API rendered for the web and mobile webviews",
  "keywords": [
    "react",
    "web",
    "webview",
    "hybrid",
    "ui",
    "components",
    "xaui"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
