{
  "name": "@xaui/ui-mcp",
  "version": "0.0.2",
  "description": "MCP server for XAUI UI components — gives AI assistants full knowledge of XAUI components, props, and usage patterns",
  "keywords": [
    "mcp",
    "ai",
    "ui",
    "react-native",
    "xaui",
    "components",
    "model-context-protocol"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "xaui-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rygrams/xaui.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://ui.xtartapp.com/docs/introduction",
  "publishConfig": {
    "access": "public"
  }
}
