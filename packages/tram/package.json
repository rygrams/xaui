{
  "name": "@xaui/tram",
  "version": "0.0.0",
  "private": true,
  "description": "XAUI components for React Native in the Tram language: Metro, modernised — flat fills, giant type, one accent colour",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme/index.js"
      },
      "require": {
        "types": "./dist/theme/index.d.cts",
        "default": "./dist/theme/index.cjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/motion/index.d.ts",
        "default": "./dist/motion/index.js"
      },
      "require": {
        "types": "./dist/motion/index.d.cts",
        "default": "./dist/motion/index.cjs"
      }
    },
    "./button": {
      "import": {
        "types": "./dist/components/button/index.d.ts",
        "default": "./dist/components/button/index.js"
      },
      "require": {
        "types": "./dist/components/button/index.d.cts",
        "default": "./dist/components/button/index.cjs"
      }
    },
    "./switch": {
      "import": {
        "types": "./dist/components/switch/index.d.ts",
        "default": "./dist/components/switch/index.js"
      },
      "require": {
        "types": "./dist/components/switch/index.d.cts",
        "default": "./dist/components/switch/index.cjs"
      }
    },
    "./typography": {
      "import": {
        "types": "./dist/components/typography/index.d.ts",
        "default": "./dist/components/typography/index.js"
      },
      "require": {
        "types": "./dist/components/typography/index.d.cts",
        "default": "./dist/components/typography/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rygrams/xaui.git",
    "directory": "packages/tram"
  },
  "scripts": {
    "build": "rm -rf dist && tsup --config tsup.config.ts && tsc --emitDeclarationOnly --declarationMap false && node ../../tooling/dual-dts/dual-dts.mjs dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@xaui/native": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.70.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "4.2.1",
    "react-native-worklets": "0.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
